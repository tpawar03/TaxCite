QDRANT_URL=http://localhost:6333
DATABASE_URL=postgresql://taxcite:taxcite@localhost:5433/taxcite
REDIS_URL=redis://localhost:6380/0

# LLM providers (T7/T8). Only the one matching TAXCITE_MODEL is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# cheapest and fastest by default; ADR-11 is settled in T8 by measurement, not price
# alternatives: claude-haiku-4-5, claude-sonnet-5
TAXCITE_MODEL=gpt-4o-mini

# Tracing (G1b): OpenTelemetry to Langfuse Cloud. Unset = tracing off. The API reads these at startup:
# uv run uvicorn taxcite.api:app --env-file .env
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
